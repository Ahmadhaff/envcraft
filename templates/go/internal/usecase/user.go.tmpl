package usecase

import (
	"errors"
	"strings"

	"{{.Module}}/internal/domain"
)

// UserService is the application API for user commands.
type UserService struct {
	repo domain.UserRepository
}

// NewUserService wires the domain repository into the use case.
func NewUserService(repo domain.UserRepository) *UserService {
	return &UserService{repo: repo}
}

// Create stores a user. ID and email are required.
func (s *UserService) Create(id, email, name string) (domain.User, error) {
	user := domain.User{
		ID:    strings.TrimSpace(id),
		Email: strings.TrimSpace(email),
		Name:  strings.TrimSpace(name),
	}
	if user.ID == "" || user.Email == "" {
		return domain.User{}, errors.New("id and email are required")
	}
	if err := s.repo.Save(user); err != nil {
		return domain.User{}, err
	}
	return user, nil
}

// Get loads a user by id.
func (s *UserService) Get(id string) (domain.User, error) {
	return s.repo.FindByID(id)
}
