package main

import (
	"log"
	"net/http"
	"os"

	"{{.Module}}/internal/adapter/httpapi"
	"{{.Module}}/internal/adapter/memory"
	"{{.Module}}/internal/usecase"
)

func main() {
	repo := memory.NewUserRepository()
	service := usecase.NewUserService(repo)
	handler := httpapi.NewHandler(service)

	addr := os.Getenv("ADDR")
	if addr == "" {
		addr = ":8080"
	}
	log.Printf("{{.Name}} listening on %s", addr)
	log.Fatal(http.ListenAndServe(addr, handler.Router()))
}
