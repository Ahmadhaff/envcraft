import { createServer, type IncomingMessage, type Server, type ServerResponse } from "node:http";
import { NotFoundError } from "../../domain/user.js";
import { UserService } from "../../application/user-service.js";
import { MemoryUserRepository } from "../../infrastructure/memory-user-repository.js";

export function createApp(): Server {
  const users = new UserService(new MemoryUserRepository());
  return createServer(async (req, res) => {
    try {
      const url = new URL(req.url ?? "/", "http://127.0.0.1");
      if (req.method === "GET" && url.pathname === "/health") {
        send(res, 200, { status: "ok", service: "{{.Name}}" });
        return;
      }
      if (req.method === "POST" && url.pathname === "/users") {
        const body = await readJSON(req);
        const user = await users.create(text(body.id), text(body.email), text(body.name));
        send(res, 201, user);
        return;
      }
      const match = /^\/users\/([^/]+)$/.exec(url.pathname);
      if (req.method === "GET" && match) {
        const user = await users.get(decodeURIComponent(match[1]));
        send(res, 200, user);
        return;
      }
      send(res, 404, { error: "not found" });
    } catch (err) {
      const status = err instanceof NotFoundError ? 404 : 400;
      const message = err instanceof Error ? err.message : "internal error";
      send(res, status, { error: message });
    }
  });
}

function text(value: unknown): string {
  return typeof value === "string" ? value : "";
}

async function readJSON(req: IncomingMessage): Promise<Record<string, unknown>> {
  const chunks: Buffer[] = [];
  for await (const chunk of req) {
    chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
  }
  if (chunks.length === 0) {
    return {};
  }
  const parsed: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8"));
  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
    throw new Error("expected a json object");
  }
  return parsed as Record<string, unknown>;
}

function send(res: ServerResponse, status: number, body: unknown): void {
  res.writeHead(status, { "content-type": "application/json; charset=utf-8" });
  res.end(JSON.stringify(body));
}
